# 运行 python3 scripts/init_dev.py 生成本地随机凭据；不要把 .env 提交到 Git。
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=paper_assistant
POSTGRES_USER=paper
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-local-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_PORT=8333
S3_ACCESS_KEY=replace-with-a-local-access-key
S3_SECRET_KEY=replace-with-a-random-local-secret
S3_REGION=us-east-1
API_PORT=8000
WEB_PORT=5173

# 仅服务端配置；未配置时小程序登录明确返回不可用
WECHAT_APP_ID=
WECHAT_APP_SECRET=

MATERIAL_BUCKET=paper-materials

# 本地嵌入模型通过 prepare_embeddings 显式准备，业务请求不下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Pi 仅支持管理员配置的 OpenAI 兼容 Chat Completions 端点，须支持流式工具调用。
# 未配置时不创建生成任务；密钥仅由 Worker 通过 stdin 交给固定执行器。
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
