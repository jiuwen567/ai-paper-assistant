.page-scroll { height: 100vh; }
.page { padding: 28rpx; color: #233b35; }
.title { font-size: 36rpx; font-weight: 600; margin: 24rpx 0; }
.card { margin: 20rpx 0; padding: 20rpx; border: 1rpx solid #c4d4c1; border-radius: 12rpx; white-space: pre-wrap; }
.error { color: #a33124; margin: 16rpx 0; }
button, picker { margin: 16rpx 0; }
textarea { width: 100%; box-sizing: border-box; padding: 16rpx; border: 1rpx solid #c4d4c1; margin: 16rpx 0; }
.actions { display: flex; gap: 16rpx; }
