.page-scroll { height: 100vh; }
.page { padding: 180rpx 40rpx 80rpx; }
.title { font-size: 48rpx; font-weight: 600; margin: 28rpx 0 20rpx; }
.card { background: #fff; border: 1rpx solid #dfe5d8; border-radius: 20rpx; padding: 36rpx; margin-bottom: 28rpx; }
.status { font-size: 34rpx; font-weight: 600; }
.detail { font-size: 25rpx; line-height: 1.8; color: #7f8c76; margin: 22rpx 0 30rpx; }
button { background: #315b44; color: white; font-size: 27rpx; border-radius: 12rpx; }
button[disabled] { background: #dce4d6; color: #73846a; }
.endpoint { margin-top: 24rpx; color: #89967e; font-size: 20rpx; }
.note { font-size: 22rpx; color: #8c997f; line-height: 1.9; padding: 10rpx; }
