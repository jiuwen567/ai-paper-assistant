<scroll-view scroll-y type="list" class="page-scroll">
  <view class="page">
    <view class="title">我的论文</view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <view wx:if="{{loading}}">处理中…</view>
    <block wx:if="{{!user}}">
      <view wx:if="{{bindingCode}}" class="card">
        <view>在已登录的 Web 账号中，展开“微信账号”并确认绑定码。</view>
        <view user-select>{{bindingCode}}</view>
        <view>绑定码 5 分钟内有效。</view>
        <button bindtap="copyCode">复制绑定码</button>
      </view>
      <button bindtap="signIn" disabled="{{loading}}">{{bindingCode ? '绑定后重新登录' : '微信登录'}}</button>
    </block>
    <block wx:else>
      <view>{{user.username}}</view>
      <block wx:if="{{!project}}">
        <button bindtap="refresh" disabled="{{loading}}">刷新项目</button>
        <view wx:if="{{!loading && !projects.length}}">暂无论文项目。</view>
        <button wx:for="{{projects}}" wx:key="id" data-id="{{item.id}}" bindtap="selectProject" disabled="{{loading}}">{{item.name}} · {{item.role === 'author' ? '作者' : '审阅者'}}</button>
        <view class="actions">
          <button wx:if="{{hasPrevious}}" bindtap="previousPage" disabled="{{loading}}">上一页</button>
          <button wx:if="{{hasNext}}" bindtap="nextPage" disabled="{{loading}}">下一页</button>
        </view>
        <button bindtap="signOut" disabled="{{loading}}">退出登录</button>
        <button bindtap="unbind" disabled="{{loading}}">解除微信绑定</button>
      </block>
      <block wx:else>
        <button bindtap="back" disabled="{{loading}}">返回项目</button>
        <view class="title">{{project.name}}</view>
        <view>{{project.paper_type}}</view>
        <view class="requirements">{{project.requirements}}</view>
        <view class="title">材料</view>
        <button bindtap="refreshMaterials" disabled="{{loading}}">刷新材料</button>
        <view wx:if="{{!loading && !materials.length}}">暂无材料。</view>
        <button wx:for="{{materials}}" wx:key="id" data-id="{{item.id}}" bindtap="selectMaterial" disabled="{{loading}}">{{item.title}}</button>
        <view class="actions">
          <button wx:if="{{materialPrevious}}" bindtap="previousMaterials" disabled="{{loading}}">上一页材料</button>
          <button wx:if="{{materialNext}}" bindtap="nextMaterials" disabled="{{loading}}">下一页材料</button>
        </view>
        <view wx:if="{{material}}" class="card">
          <view>{{material.title}} · 版本记录</view>
          <view wx:for="{{versions}}" wx:key="id">
            <view>v{{item.number}} · {{item.file_name}} · {{item.label}}</view>
            <view wx:if="{{item.error_message}}">{{item.error_message}}</view>
            <button wx:if="{{item.status === 'available' && item.canOpen}}" data-id="{{item.id}}" bindtap="download" disabled="{{loading}}">下载文档</button>
            <button wx:if="{{item.status !== 'available' && item.created_by === user.id && project.role === 'author'}}" data-version="{{item.id}}" bindtap="uploadMaterial" disabled="{{loading}}">重新选择文件上传</button>
          </view>
          <view class="actions">
            <button wx:if="{{versionPrevious}}" bindtap="previousVersions" disabled="{{loading}}">较新版本</button>
            <button wx:if="{{versionNext}}" bindtap="nextVersions" disabled="{{loading}}">较旧版本</button>
          </view>
        </view>
        <block wx:if="{{project.role === 'author'}}">
          <button wx:if="{{material}}" bindtap="newMaterial" disabled="{{loading}}">新增材料</button>
          <picker wx:if="{{!material}}" range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory" disabled="{{loading}}"><view>材料分类：{{categories[categoryIndex]}}</view></picker>
          <button bindtap="uploadMaterial" disabled="{{loading}}">{{material ? '上传新版本' : '选择文件上传'}}</button>
          <button wx:if="{{pendingUpload || pendingIntent}}" bindtap="retryUpload" disabled="{{loading}}">重试同一文件</button>
        </block>
        <view class="title">后台任务</view>
        <button bindtap="refreshJobs" disabled="{{loading}}">刷新任务</button>
        <view wx:if="{{!loading && !jobs.length}}">暂无任务。</view>
        <view wx:for="{{jobs}}" wx:key="id" class="card">
          <view>{{item.status}} · {{item.progress}}%</view>
          <view wx:if="{{item.error_message}}">{{item.error_message}}</view>
        </view>
        <view class="actions">
          <button wx:if="{{jobPrevious}}" bindtap="previousJobs" disabled="{{loading}}">上一页任务</button>
          <button wx:if="{{jobNext}}" bindtap="nextJobs" disabled="{{loading}}">下一页任务</button>
        </view>
      </block>
    </block>
  </view>
</scroll-view>
